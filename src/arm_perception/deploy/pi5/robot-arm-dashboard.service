[Unit]
Description=Robot Arm read-only robot dashboard
After=network-online.target robot-arm-camera.service
Wants=network-online.target robot-arm-camera.service

[Service]
Type=simple
Environment=ROS_DOMAIN_ID=0
Environment=PYTHONUNBUFFERED=1
Environment=ROBOT_ARM_RUNTIME_ROOT=/opt/robot_arm
Environment=ROBOT_ARM_BIND_ADDR=127.0.0.1
EnvironmentFile=-/etc/robot_arm/robot_arm.env
ExecStart=/bin/bash -c 'source /opt/ros/jazzy/setup.bash && source "$ROBOT_ARM_RUNTIME_ROOT/current/install/setup.bash" && exec ros2 run arm_perception web_console --ros-args -p bind_address:=$ROBOT_ARM_BIND_ADDR -p port:=8088 -p recordings_root:="$ROBOT_ARM_RUNTIME_ROOT/recordings"'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
