[Unit]
Description=Robot Arm read-only robot dashboard
# Bind adresi cihazda henuz yoksa servis, restart dongusune girmek yerine
# adresin gelmesini sinirli sure bekler.
StartLimitIntervalSec=1800
StartLimitBurst=45
After=network-online.target robot-arm-camera.service
Wants=network-online.target

[Service]
Type=simple
Environment=ROS_DOMAIN_ID=0
Environment=PYTHONUNBUFFERED=1
Environment=ROBOT_ARM_RUNTIME_ROOT=/opt/robot_arm
Environment=ROBOT_ARM_BIND_ADDR=127.0.0.1
EnvironmentFile=-/etc/robot_arm/robot_arm.env
# ExecStartPre ve ExecStart ayni operator-saglanan adresi kullanir.
ExecStartPre=/bin/bash -c 'until ip -4 -o addr show | grep -qw "$ROBOT_ARM_BIND_ADDR"; do sleep 5; done'
ExecStart=/bin/bash -c 'source /opt/ros/jazzy/setup.bash && source "$ROBOT_ARM_RUNTIME_ROOT/current/install/setup.bash" && exec ros2 run arm_perception web_console --ros-args -p bind_address:=$ROBOT_ARM_BIND_ADDR -p port:=8088 -p recordings_root:="$ROBOT_ARM_RUNTIME_ROOT/recordings" -p raw_image_max_fps:=30.0 -p camera_config_dir:="$ROBOT_ARM_RUNTIME_ROOT/current/install/arm_perception/share/arm_perception/config" -p measurement_registry:="$ROBOT_ARM_RUNTIME_ROOT/current/install/arm_perception/share/arm_perception/config/measurement_registry.yaml"'
# Bekleme bu sureyi asarsa unit basarisiz olur ve Restart ile yeniden
# dener; boylece ag cok gec gelse bile servis kendini toparlar.
TimeoutStartSec=900
Restart=on-failure
RestartSec=20

[Install]
WantedBy=default.target
